# latest miniconda ships anaconda-auth (needs py>=3.9), so pin an older tag for py3.8.5
FROM continuumio/miniconda3:4.9.2

# install python 3.8.5
RUN conda install -y python=3.8.5

RUN echo '\
   Acquire::Retries "100";\
   Acquire::https::Timeout "240";\
   Acquire::http::Timeout "240";\
   APT::Get::Assume-Yes "true";\
   APT::Install-Recommends "false";\
   APT::Install-Suggests "false";\
   Debug::Acquire::https "true";\
   ' > /etc/apt/apt.conf.d/99custom

# buster is EOL — official mirrors 404, use archive
RUN sed -i 's|deb.debian.org|archive.debian.org|g; s|security.debian.org|archive.debian.org|g' /etc/apt/sources.list \
    && sed -i '/buster-updates/d' /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid

# install mujoco
RUN apt-get update
RUN apt-get install build-essential --yes
RUN cd /root \
    && mkdir .mujoco \
    && wget https://mujoco.org/download/mujoco210-linux-x86_64.tar.gz \
    && tar -xf mujoco210-linux-x86_64.tar.gz -C .mujoco
ENV LD_LIBRARY_PATH=/root/.mujoco/mujoco210/bin:${LD_LIBRARY_PATH}

# install mujoco_py (needs -lGL / glew for first-time cymj build)
RUN apt-get install -y \
    libosmesa6-dev \
    libgl1-mesa-dev \
    libgl1-mesa-glx \
    libglew-dev \
    patchelf
# conda's ld ignores system lib paths → "cannot find -lGL" when building cymj
RUN rm -f /opt/conda/compiler_compat/ld
RUN pip install onnxruntime free-mujoco-py
# compile cymj at image build time (not on first training import)
RUN python -c "import mujoco_py; print('mujoco_py ok')"

# install torch with cuda support
# typing-extensions>=4.14 needs py>=3.9; pin for py3.8
# moviepy>=2 needs numpy>=1.25 (no py3.8 wheels)
RUN pip install "typing-extensions==4.13.2" \
    && pip install torch==1.12.1+cu113 torchvision==0.13.1+cu113 torchaudio==0.12.1 --extra-index-url https://download.pytorch.org/whl/cu113 \
    && pip install "tensorflow==2.13.1" \
    && pip install "wandb==0.16.6" "moviepy==1.0.3" "opencv-python==4.8.1.78"

# fixed&additional pip deps
#RUN apt-get install libopenmpi-dev
#RUN pip install mpi4py
RUN pip install setuptools==65.5.0 "wheel<0.40.0"
RUN pip install gym
RUN pip install gymnasium==0.29.1
RUN pip install pandas==1.5.3
RUN pip install matplotlib==3.6.2
RUN pip install stable_baselines3==2.3.0 --no-deps
RUN pip install numpy==1.23.4
RUN pip install imageio-ffmpeg==0.4.9
RUN pip install scikit-learn==1.3.2

# Install Safety-Gym
RUN mkdir -p /usr/home/workspace/safety-gym
COPY safety-gym /usr/home/workspace/safety-gym
RUN cd /usr/home/workspace/safety-gym \
    && pip install -e .

# fix after safety gym installation
RUN pip install numpy==1.23.4

RUN pip install comet_ml

# mb rce deps
#RUN apt-get install libopenmpi-dev
#ADD requirements.txt /tmp/
#RUN pip install -r /tmp/requirements.txt
#RUN pip install lightgbm
#RUN pip install pip install scikit-learn
RUN echo "cd /usr/home/workspace/bullet_safety_gym_env && pip install -e ." >> ~/.bashrc
RUN echo "cd /usr/home/workspace" >> ~/.bashrc

WORKDIR /usr/home/workspace

# install safety gym
#CMD cd /usr/home/workspace/safety-gym && pip install -e .
RUN echo "/usr/home/workspace/exps/ites" >> ~/.bashrc
